// ============ CRAVINGS POPUP RULES (CROSS-SELL / UPSELL) ============
// Admin creates rules: IF customer adds <triggerItem> THEN show <recommended items>
// in the add-to-cart popup to increase average order value.

enum CravingsPriority {
  HIGH
  MEDIUM
  LOW
}

model CravingsRule {
  id            String           @id @default(cuid())
  name          String
  triggerItemId String
  kitchenId     String
  title         String           @default("Complete Your Meal 🍽️")
  message       String           @default("Customers usually order these together.")
  priority      CravingsPriority @default(MEDIUM)
  isActive      Boolean          @default(true)
  updatedBy     String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  triggerItem MenuItem         @relation("cravingsTriggerItem", fields: [triggerItemId], references: [id])
  kitchen     KitchenPartner   @relation("cravingsTriggerKitchen", fields: [kitchenId], references: [id])
  items       CravingsRuleItem[]

  @@index([triggerItemId])
  @@index([kitchenId])
  @@index([priority])
  @@index([isActive])
  @@map("cravings_rule")
}

model CravingsRuleItem {
  id         String @id @default(cuid())
  ruleId     String
  menuItemId String
  sortOrder  Int    @default(0)

  rule     CravingsRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  menuItem MenuItem     @relation(fields: [menuItemId], references: [id])

  @@unique([ruleId, menuItemId])
  @@index([menuItemId])
  @@map("cravings_rule_item")
}

// ============ PUBLIC ID COUNTERS ============

model PublicIdCounter {
  id       String @id @default(cuid())
  prefix   String @unique
  sequence Int    @default(0)
  digits   Int

  @@map("public_id_counter")
}
