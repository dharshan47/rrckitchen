// ============ ADMIN PROTECTION ============

enum AdminPermission {
  MANAGE_ADMINS
  APPROVE_KYC
  MANAGE_CATALOG
  ISSUE_REFUNDS
  MANAGE_PAYOUTS
  MANAGE_COUPONS
  VIEW_FINANCIALS
