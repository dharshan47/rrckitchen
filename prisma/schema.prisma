generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ IDENTITY & ACCESS ============

model User {
  id                  String    @id @default(cuid())
  publicCode          String?   @unique
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  role                String    @default("user") @map("role")
  banned              Boolean   @default(false)
  banReason           String?
  banExpires          DateTime?
  name                String?
  fullName            String?
  email               String?   @unique
  emailVerified       Boolean   @default(false)
  image               String?
  isActive            Boolean   @default(true)
  razorpayCustomerId  String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  deletedAt           DateTime?

  customer            Customer?
  userRoles           UserRole[]
  sessions            Session[]
  accounts            Account[]
  otpCodes            OtpCode[]
  addresses           Address[]
  orders              Order[]
  reviews             Review[]
  deliveryReviews     DeliveryReview[]
  kitchenPartner      KitchenPartner?
  deliveryPartner     DeliveryPartner?
  pushSubscriptions   PushSubscription[]
  menuItemFeedbacks   MenuItemFeedback[]
  menuItemReviews     MenuItemReview[]
  supportTickets      SupportTicket[]
  referralsMade       Referral[]           @relation("referrer")
  referralsUsed       Referral[]           @relation("referred")
  loyaltyPoints       LoyaltyPoints?
  loyaltyTransactions LoyaltyTransaction[]
  loyaltyCouponPurchases LoyaltyCouponPurchase[]
  notificationLogs    NotificationLog[]
  twoFactorEnabled    Boolean?
  twoFactors          TwoFactor[]
  adminProfile        AdminProfile?
  wishlistItems       WishlistItem[]
  kitchenWishlists    KitchenWishlist[]

  @@index([phoneNumber])
  @@map("user")
}

model Role {
  id        String     @id @default(cuid())
  name      RoleName   @unique
  userRoles UserRole[]
}

model Customer {
  id          String    @id @default(cuid())
  publicCode  String?   @unique
  userId      String    @unique
  name        String?
  email       String?
  phoneNumber String?
  avatarUrl   String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([isActive])
  @@index([createdAt])
  @@map("customer")
}

enum RoleName {
  CUSTOMER
  KITCHENPARTNER
  DELIVERYPARTNER
  ADMIN
  SUPPORTAGENT
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
}

model Session {
  id             String   @id @default(cuid())
  userId         String
  token          String   @unique
  expiresAt      DateTime
  ipAddress      String?
  impersonatedBy String?
  userAgent      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model OtpCode {
  id           String    @id @default(cuid())
  userId       String?
  mobileNumber String
  code         String
  expiresAt    DateTime
  attempts     Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  user         User?     @relation(fields: [userId], references: [id])

  @@index([mobileNumber])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  label         String?
  lineOne       String
  lineTwo       String?
  pincode       String
  serviceZoneId String
  latitude      Float?
  longitude     Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  serviceZone ServiceZone @relation(fields: [serviceZoneId], references: [id])
  orders      Order[]

  @@index([userId])
  @@index([serviceZoneId])
}

// ============ KITCHEN PARTNER DOMAIN ============

model KitchenPartner {
  id             String        @id @default(cuid())
  publicCode     String?       @unique
  slug           String        @unique
  userId         String        @unique
  status         PartnerStatus @default(PENDINGAPPROVAL)
  approvedAt     DateTime?
  rejectedReason String?
  serviceZoneId  String?
  avgRating      Decimal       @default(0)
  totalReviews   Int           @default(0)
  operatingHours Json?
  createdAt         DateTime      @default(now())
  estimatedPrepTime Int?          @default(25)
  minOrder          Int?          @default(99)
  deliveryRadiusKm  Float?        @default(2.1)
  updatedAt         DateTime      @updatedAt
  deletedAt      DateTime?

  user                       User                               @relation(fields: [userId], references: [id])
  kitchenAlias               KitchenAlias?
  kitchenKyc                 KitchenPartnerKyc?
  kitchenAddress             KitchenAddress?
  kitchenCategories          KitchenCategory[]
  kitchenAvailability        KitchenAvailability[]
  menus                      Menu[]
  deliveryPartnerAssignments DeliveryPartnerKitchenAssignment[]
  orderItems                 OrderItem[]
  reviews                    Review[]
  rrcKitchenReview           RrcKitchenReview?
  serviceZone                ServiceZone?                       @relation(fields: [serviceZoneId], references: [id])
  coupons                    Coupon[]
  kitchenPayouts             KitchenPayout[]
  kitchenWishlists           KitchenWishlist[]
  cravingsTriggerRules       CravingsRule[]      @relation("cravingsTriggerKitchen")

  @@index([status, createdAt])
  @@index([serviceZoneId])
  @@index([avgRating])
}

enum PartnerStatus {
  PENDINGAPPROVAL
  APPROVED
  ACTIVE
  SUSPENDED
  REJECTED
}

model KitchenPartnerKyc {
  id                 String    @id @default(cuid())
  kitchenPartnerId   String    @unique
  aadhaarVerified    Boolean   @default(false)
  aadhaarDocumentUrl String?
  addressProofUrl    String?
  reviewedByAdminId  String?
  reviewedAt         DateTime?
  bankName           String?
  bankAccountNumber  String?
  ifscCode           String?
  accountHolderName  String?
  upiId              String?
  gpayNumber         String?
  phoneNumber        String?
  fssaiNumber        String?
  fssaiValidTill     DateTime?
  gstNumber          String?

  kitchenPartner KitchenPartner @relation(fields: [kitchenPartnerId], references: [id])
}

model KitchenAlias {
  id               String   @id @default(cuid())
  kitchenPartnerId String   @unique
  displayName      String   @unique
  sequenceNumber   Int      @unique
  imageUrl         String?
  coverImageUrl    String?
  description      String?
  customOfferText  String?
  createdAt        DateTime @default(now())

  kitchenPartner KitchenPartner @relation(fields: [kitchenPartnerId], references: [id])
}

model KitchenCategory {
  id               String @id @default(cuid())
  kitchenPartnerId String
  categoryId       String

  kitchenPartner KitchenPartner @relation(fields: [kitchenPartnerId], references: [id])
  category       Category       @relation(fields: [categoryId], references: [id])

  @@unique([kitchenPartnerId, categoryId])
  @@index([categoryId])
}

model KitchenAvailability {
  id               String   @id @default(cuid())
  kitchenPartnerId String
  serviceDate      DateTime
  isAvailable      Boolean
  respondedAt      DateTime @default(now())

  kitchenPartner KitchenPartner @relation(fields: [kitchenPartnerId], references: [id])

  @@unique([kitchenPartnerId, serviceDate])
  @@index([serviceDate, isAvailable])
}

model Menu {
  id               String   @id @default(cuid())
  kitchenPartnerId String
  name             String
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  kitchenPartner KitchenPartner @relation(fields: [kitchenPartnerId], references: [id])
  menuItems      MenuItem[]

  @@index([kitchenPartnerId, isActive])
  @@index([isActive])
}

model MenuItem {
  id             String    @id @default(cuid())
  publicCode     String?   @unique
  slug           String?   @unique
  menuId         String
  name           String
  description    String?
  price          Decimal
  compareAtPrice Decimal?
  foodType       FoodType
  timeSlot       TimeSlot
  isAvailable    Boolean   @default(true)
  availableFor   AvailableFor @default(BOTH)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  // CMS / menu-detail management fields
  cuisine          String?
  categoryId       String?
  bestseller       Boolean  @default(false)
  highlights       Json?
  aboutTitle       String?
  aboutDescription String?
  serves           Int?
  portionSize      String?
  shelfLife        String?
  allergens        String?
  metaTitle        String?
  metaDescription  String?
  deliveryTimeMin  Int?
  deliveryTimeMax  Int?
  deliveryFee      Decimal?
  freeDelivery     Boolean  @default(false)
  packagingType    String?
  relatedItemIds   String[] @default([])

  menu              Menu                 @relation(fields: [menuId], references: [id])
  category          Category?            @relation(fields: [categoryId], references: [id])
  photos            MenuItemPhoto[]
  orderItems        OrderItem[]
  menuItemFeedbacks MenuItemFeedback[]
  menuItemReviews   MenuItemReview[]
  wishlistItems     WishlistItem[]
  avgRating         Decimal              @default(0)
  totalReviews      Int                  @default(0)
  cravingsTriggers  CravingsRule[]       @relation("cravingsTriggerItem")
  cravingsRuleItems CravingsRuleItem[]

  @@index([menuId, timeSlot, foodType])
  @@index([isAvailable, timeSlot, foodType])
  @@index([isAvailable, foodType, timeSlot])
  @@index([isAvailable, menuId])
  @@index([categoryId])
}

enum AvailableFor {
  TODAY
  TOMORROW
  BOTH
}

enum FoodType {
  VEG
  NONVEG
}

enum TimeSlot {
  MORNING
  LUNCH
  EVENINGSNACKS
  DINNER
}

model MenuItemPhoto {
  id                 String  @id @default(cuid())
  menuItemId         String
  imageUrl           String
  cloudinaryPublicId String?
  sortOrder          Int     @default(0)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([menuItemId])
}

// ============ DELIVERY PARTNER DOMAIN ============

model DeliveryPartner {
  id           String        @id @default(cuid())
  publicCode   String?       @unique
  userId       String        @unique
  status       PartnerStatus @default(PENDINGAPPROVAL)
  approvedAt   DateTime?
  isOnline     Boolean       @default(false)
  avgRating    Decimal       @default(0)
  totalReviews Int           @default(0)
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?

  user                User                               @relation(fields: [userId], references: [id])
  kyc                 DeliveryPartnerKyc?
  catalogueItems      DeliveryPartnerCatalogueItem[]
  kitchenAssignments  DeliveryPartnerKitchenAssignment[]
  reviews             DeliveryReview[]
  orders              Order[]
  deliveryAssignments DeliveryAssignment[]
  deliveryLocations   DeliveryLocation[]
  deliveryPayouts     DeliveryPartnerPayout[]

  @@index([status])
}

model DeliveryPartnerKyc {
  id                String    @id @default(cuid())
  deliveryPartnerId String    @unique
  documentUrl       String?
  verifiedAt        DateTime?
  bankName          String?
  bankAccountNumber String?
  ifscCode          String?
  accountHolderName String?
  upiId             String?
  googlePayNumber   String?
  phonePeNumber     String?

  deliveryPartner DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])
}

model DeliveryPartnerCatalogueItem {
  id                String  @id @default(cuid())
  deliveryPartnerId String
  itemName          String
  unit              String
  ratePerUnit       Decimal

  deliveryPartner DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])

  @@index([deliveryPartnerId])
}

model DeliveryPartnerKitchenAssignment {
  id                String           @id @default(cuid())
  deliveryPartnerId String
  kitchenPartnerId  String
  assignedByAdminId String
  status            AssignmentStatus @default(PENDING)
  createdAt         DateTime         @default(now())

  deliveryPartner DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])
  kitchenPartner  KitchenPartner  @relation(fields: [kitchenPartnerId], references: [id])

  @@index([deliveryPartnerId])
  @@index([kitchenPartnerId])
}

enum AssignmentStatus {
  PENDING
  DELIVERED
  CANCELLED
}

// ============ CATALOGUE / REFERENCE ============

model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  imageUrl    String?
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())

  kitchenCategories  KitchenCategory[]
  menuItems          MenuItem[]
  categoryPageContent CategoryPageContent?

  @@index([isActive])
}

model ServiceZone {
  id       String   @id @default(cuid())
  name     String   @unique
  pincodes String[]
  isActive Boolean  @default(true)

  addresses       Address[]
  kitchenPartners KitchenPartner[]
}

// ============ COMMERCE ============

model Order {
  id                String          @id @default(cuid())
  publicCode        String?         @unique
  userId            String
  addressId         String?
  serviceDate       DateTime
  serviceDateType   ServiceDateType @default(TOMORROW)
  timeSlot          TimeSlot
  status            OrderStatus     @default(CONFIRMED)
  totalAmount       Decimal
  discountAmount    Decimal         @default(0)
  commissionAmount  Decimal
  source            OrderSource     @default(APP)
  deliveryPartnerId String?
  deliveryStatus    DeliveryStatus?
  idempotencyKey    String?         @unique
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user                   User                    @relation(fields: [userId], references: [id])
  address                Address?                @relation(fields: [addressId], references: [id])
  deliveryPartner        DeliveryPartner?        @relation(fields: [deliveryPartnerId], references: [id])
  orderItems             OrderItem[]
  statusHistory          OrderStatusHistory[]
  payment                Payment?
  couponRedemption       CouponRedemption?
  review                 Review?
  deliveryReview         DeliveryReview?
  menuItemFeedbacks      MenuItemFeedback[]
  menuItemReviews        MenuItemReview[]
  deliveryLocations      DeliveryLocation[]
  deliveryAssignment     DeliveryAssignment?
  refunds                Refund[]
  kitchenPayouts         KitchenPayout[]
  deliveryPartnerPayouts DeliveryPartnerPayout[]
  supportTickets         SupportTicket[]
  upiCollectRequest      UpiCollectRequest?

  @@index([userId])
  @@index([serviceDate, timeSlot])
  @@index([status])
  @@index([deliveryPartnerId])
}

enum OrderStatus {
  CONFIRMED
  PREPARING
  READYFORPICKUP
  COMPLETED
  CANCELLED
  REFUNDED
}

enum ServiceDateType {
  TODAY
  TOMORROW
  FUTURE
}

enum DeliveryStatus {
  ASSIGNED
  ACCEPTED
  PICKEDUP
  INTRANSIT
  DELIVERED
  FAILED
}

enum OrderSource {
  APP
  PHONECALL
}

model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  menuItemId       String
  kitchenPartnerId String
  quantity         Int
  unitPrice        Decimal
  packagingFee     Decimal         @default(0)
  status           OrderItemStatus @default(CONFIRMED)

  order            Order            @relation(fields: [orderId], references: [id])
  menuItem         MenuItem         @relation(fields: [menuItemId], references: [id])
  kitchenPartner   KitchenPartner   @relation(fields: [kitchenPartnerId], references: [id])
  menuItemReviews  MenuItemReview[]

  @@index([orderId])
  @@index([kitchenPartnerId])
  @@index([menuItemId])
}

enum OrderItemStatus {
  CONFIRMED
  UNAVAILABLE
  REFUNDED
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  changedAt DateTime    @default(now())
  note      String?

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model Review {
  id                String   @id @default(cuid())
  orderId           String   @unique
  userId            String
  kitchenPartnerId  String
  rating            Int
  tasteRating       Int?
  packagingRating   Int?
  portionSizeRating Int?
  comment           String?
  mediaUrls         String[]
  createdAt         DateTime @default(now())

  order          Order          @relation(fields: [orderId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  kitchenPartner KitchenPartner @relation(fields: [kitchenPartnerId], references: [id])

  @@index([kitchenPartnerId, createdAt])
  @@index([createdAt])
  @@index([userId])
}

model DeliveryReview {
  id                String   @id @default(cuid())
  orderId           String   @unique
  userId            String
  deliveryPartnerId String
  rating            Int
  speedRating       Int?
  behaviorHygiene   Boolean?
  safetyContactless Boolean?
  comment           String?
  mediaUrls         String[]
  createdAt         DateTime @default(now())

  order           Order           @relation(fields: [orderId], references: [id])
  user            User            @relation(fields: [userId], references: [id])
  deliveryPartner DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])

  @@index([deliveryPartnerId])
}

// ============ RRC KITCHEN PLATFORM REVIEWS ============

model RrcKitchenReview {
  id               String    @id @default(cuid())
  kitchenPartnerId String    @unique
  rating           Int
  recommendation   Boolean?
  comment          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  kitchenPartner KitchenPartner @relation(fields: [kitchenPartnerId], references: [id])

  @@index([rating])
}

// ============ MENU ITEM FEEDBACK ============

model MenuItemFeedback {
  id          String   @id @default(cuid())
  orderId     String
  orderItemId String
  userId      String
  menuItemId  String
  thumbsUp    Boolean?
  tags        String[]

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([orderId, orderItemId])
  @@index([menuItemId])
  @@index([orderId])
}

// ============ MENU ITEM REVIEW (STAR RATING) ============

model MenuItemReview {
  id          String   @id @default(cuid())
  orderId     String
  orderItemId String
  userId      String
  menuItemId  String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  order     Order     @relation(fields: [orderId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])
  menuItem  MenuItem  @relation(fields: [menuItemId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([orderId, orderItemId])
  @@index([menuItemId])
}

// ============ DELIVERY ASSIGNMENT ============

model DeliveryAssignment {
  id                String           @id @default(cuid())
  orderId           String           @unique
  deliveryPartnerId String
  assignedByAdminId String
  status            AssignmentStatus @default(PENDING)
  acceptedAt        DateTime?
  pickedUpAt        DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime         @default(now())

  order           Order           @relation(fields: [orderId], references: [id])
  deliveryPartner DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])
}

// ============ DELIVERY LOCATION TRACKING ============

model DeliveryLocation {
  id                String   @id @default(cuid())
  orderId           String
  deliveryPartnerId String
  latitude          Float
  longitude         Float
  accuracy          Float?
  updatedAt         DateTime @default(now())

  order           Order           @relation(fields: [orderId], references: [id])
  deliveryPartner DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id])

  @@index([orderId])
  @@index([deliveryPartnerId])
  @@index([updatedAt])
}

// ============ PAYMENT ============

model Payment {
  id                  String          @id @default(cuid())
  publicCode          String?         @unique
  orderId             String          @unique
  provider            PaymentProvider
  providerOrderId     String?
  providerPaymentId   String?
  paymentMethod       String?
  paymentMethodDetail Json?           // { method, app, vpa, bank, wallet, card_brand }
  amount              Decimal
  status              PaymentStatus   @default(PENDING)
  idempotencyKey      String?         @unique
  paidAt              DateTime?
  createdAt           DateTime        @default(now())

  order              Order               @relation(fields: [orderId], references: [id])
  refunds            Refund[]
  upiCollectRequest  UpiCollectRequest?

  @@index([status])
  @@index([idempotencyKey])
}

enum PaymentStatus {
  PENDING
  SUCCESS
  PARTIAL_REFUND
  FAILED
  REFUNDED
}

enum PaymentProvider {
  RAZORPAY
  UPI_COLLECT
}

// ============ PUSH NOTIFICATIONS ============

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ============ DELIVERY SLOT ============

model DeliverySlot {
  id         String  @id @default(cuid())
  name       String
  startTime  String
  endTime    String
  cutoffTime String?
  isActive   Boolean @default(true)
}

// ============ NOTIFICATION LOG ============

model NotificationLog {
  id          String   @id @default(cuid())
  userId      String
  channel     String   @default("PUSH")
  templateKey String?
  title       String?
  body        String?
  status      String   @default("SENT")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("notification_log")
}

// ============ SUPPORT TICKET ============

model SupportTicket {
  id          String         @id @default(cuid())
  publicCode  String?        @unique
  userId      String?
  guestId     String?
  orderId     String?
  subject     String
  description String
  category    String         @default("other")
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  mediaUrls   String[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages TicketMessage[]
  user     User?           @relation(fields: [userId], references: [id])
  order    Order?          @relation(fields: [orderId], references: [id])

  @@index([userId])
  @@index([guestId])
  @@index([status])
  @@index([category])
  @@map("support_ticket")
}

enum TicketStatus {
  OPEN
  INPROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String?
  message   String
  mediaUrls String[]
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("ticket_message")
}

// ============ CONTACT / SUPPORT MESSAGES ============

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
  @@map("contact_message")
}

// ============ REFERRAL ============

model Referral {
  id           String   @id @default(cuid())
  referrerId   String
  referredId   String?
  referralCode String   @unique
  status       String   @default("PENDING")
  rewardAmount Decimal  @default(0)
  rewardPaid   Boolean  @default(false)
  createdAt    DateTime @default(now())

  referrer User  @relation("referrer", fields: [referrerId], references: [id])
  referred User? @relation("referred", fields: [referredId], references: [id])

  @@index([referrerId])
  @@index([referralCode])
  @@map("referral")
}

// ============ LOYALTY POINTS ============

model LoyaltyPoints {
  id             String   @id @default(cuid())
  userId         String   @unique
  points         Int      @default(0)
  lifetimePoints Int      @default(0)
  tier           String   @default("BRONZE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@map("loyalty_points")
}

model LoyaltyTransaction {
  id          String   @id @default(cuid())
  userId      String
  points      Int
  type        String
  reference   String?
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("loyalty_transaction")
}

// ============ LOYALTY COUPONS (purchasable with points) ============

model LoyaltyCoupon {
  id            String       @id @default(cuid())
  name          String
  description   String?
  discountType  DiscountType
  discountValue Decimal
  maxDiscount   Decimal?
  minOrderValue Decimal?
  pointsCost    Int
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())

  purchases LoyaltyCouponPurchase[]

  @@map("loyalty_coupon")
}

model LoyaltyCouponPurchase {
  id              String   @id @default(cuid())
  userId          String
  loyaltyCouponId String
  couponCode      String   @unique
  discountType    DiscountType
  discountValue   Decimal
  maxDiscount     Decimal?
  minOrderValue   Decimal?
  used            Boolean  @default(false)
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id])
  loyaltyCoupon LoyaltyCoupon @relation(fields: [loyaltyCouponId], references: [id])

  @@index([userId])
  @@map("loyalty_coupon_purchase")
}

// ============ COUPONS & PROMOTIONS ============

model Coupon {
  id                String       @id @default(cuid())
  code              String       @unique
  description       String?
  discountType      DiscountType
  discountValue     Decimal
  maxDiscount       Decimal?
  minOrderValue     Decimal?
  scope             CouponScope  @default(PLATFORM)
  kitchenPartnerId  String?
  validFrom         DateTime
  validTo           DateTime
  usageLimitTotal   Int?
  usageLimitPerUser Int?         @default(1)
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())

  redemptions    CouponRedemption[]
  kitchenPartner KitchenPartner?    @relation(fields: [kitchenPartnerId], references: [id])

  @@index([code])
  @@index([kitchenPartnerId])
}

enum DiscountType {
  FLAT
  PERCENTAGE
}

enum CouponScope {
  PLATFORM
  KITCHEN_SPECIFIC
}

model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  userId         String
  orderId        String   @unique
  discountAmount Decimal
  createdAt      DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([couponId])
  @@index([userId])
}

// ============ PAYMENT OFFERS ============

enum PaymentOfferType {
  UPI
  WALLET
  CARDS
  NETBANKING
  ALL
}

model PaymentOffer {
  id            String           @id @default(cuid())
  name          String
  description   String?
  offerType     PaymentOfferType
  discountType  DiscountType
  discountValue Decimal
  maxDiscount   Decimal?
  minOrderValue Decimal?
  validFrom     DateTime
  validTo       DateTime
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
}

// ============ UPI SMART COLLECT ============

model UpiCollectRequest {
  id             String           @id @default(cuid())
  orderId        String           @unique
  paymentId      String           @unique
  vpa            String           // Virtual Payment Address e.g. rrc.order123@razorpay
  razorpayVpaId  String?          @unique
  status         UpiCollectStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  order   Order   @relation(fields: [orderId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([status])
  @@map("upi_collect_request")
}

enum UpiCollectStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

// ============ REFUNDS ============

model Refund {
  id               String       @id @default(cuid())
  publicCode       String?      @unique
  orderId          String
  orderItemId      String?
  paymentId        String
  razorpayRefundId String?      @unique
  amount           Decimal
  reason           RefundReason
  status           RefundStatus @default(INITIATED)
  initiatedAt      DateTime     @default(now())
  processedAt      DateTime?

  order   Order   @relation(fields: [orderId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@index([status])
}

enum RefundReason {
  ITEM_OUT_OF_STOCK
  KITCHEN_REJECTED
  CUSTOMER_CANCELLED
  QUALITY_ISSUE
  LATE_DELIVERY
  OTHER
}

enum RefundStatus {
  INITIATED
  PROCESSING
  PROCESSED
  FAILED
}

// ============ PAYOUTS ============

model KitchenPayout {
  id                   String       @id @default(cuid())
  kitchenPartnerId     String
  orderId              String       @unique
  grossAmount          Decimal
  commissionAmount     Decimal
  couponBorneByKitchen Decimal      @default(0)
